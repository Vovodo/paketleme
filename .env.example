# Coolify / Docker Ortam Değişkenleri
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@<POSTGRES_HOST>:5432/paketleme

# Yönetici ayar ekranı şifresi
ADMIN_PASSWORD=CHANGE_ME

# Opsiyonel: Telegram Bot Token ve Grup Chat ID (Ayarlar ekranından da girilebilir, DB'de saklanır)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

PORT=8000
APP_ENV=production
CORS_ORIGINS=*
